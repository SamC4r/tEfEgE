{
    "cSpell.language": "es",
    "cSpell.defaultLanguage": "es",
    "cSpell.enableFiletypes": ["latex", "tex", "markdown"],
    "cSpell.minWordLength": 1,
    "[tex]": {
        "editor.defaultFormatter": null
    },
    "cSpell.ignoreRegExpList": [
        "\\\\[a-z]+",
        "\\\\{[^}]*\\}",
        "%.*$",
        "\\\\begin\\{comment\\}[^}]*?\\\\end\\{comment\\}",
        "\\\\begin\\s*\\{\\s*comment\\s*\\}[\\s\\S]*?\\\\end\\s*\\{\\s*comment\\s*\\}"
    ],
    "cSpell.words": [
        "a",
        "códecs",
        "drizzle",
        "e",
        "env",
        "framework",
        "gamificación",
        "hermano",
        "hosting",
        "intrusivo",
        "monetización",
        "monetizar",
        "o",
        "Ofcom",
        "precarga",
        "restrictor",
        "strings",
        "subsección",
        "tailwind",
        "tipada",
        "transcodificación",
        "u",
        "verano",
        "Vercel",
        "vídeos",
        "y",
        "YouTube"
    ],
    "ltex.enabled": false
}